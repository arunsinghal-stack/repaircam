# RepairCam web UI as a system service.
#
# Do not edit this file by hand — it is a template. The placeholders are filled
# in by deploy/install-service.sh, which installs the result to
# /etc/systemd/system/repaircam.service.
#
#     ./deploy/install-service.sh
#
# Runs as the ordinary shop user, not root: the recordings live in that user's
# home directory, and nothing here needs administrator powers.

[Unit]
Description=RepairCam — bench recording web UI
Documentation=https://github.com/arunsinghal-stack/repaircam

# Wait for the network to be genuinely up. Plain network.target is satisfied
# before an address is assigned, and RepairCam is useless until it can reach the
# cameras on the shop LAN.
After=network-online.target
Wants=network-online.target

# No start-rate limit. Without this, systemd gives up permanently after a few
# rapid restarts — so if the camera is unplugged overnight, the recorder would
# have stopped trying by morning. It must still be trying when the shop opens.
# (This belongs in [Unit]; systemd silently ignores it under [Service].)
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__WORKDIR__

Environment=PYTHONUNBUFFERED=1
Environment=REPAIRCAM_DATA_DIR=__DATADIR__
ExecStart=__PYTHON__ -m repaircam.cli web --host __HOST__ --port __PORT__

# Keep the bench running. A camera outage, an ffmpeg crash or an unhandled error
# must not leave the shop without a recorder until someone notices.
Restart=always
RestartSec=5

# Give in-progress recordings a chance to finalise on stop or reboot. ffmpeg is
# sent 'q' and needs a moment to write the MP4 index; killing it early corrupts
# the clip.
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=repaircam

# Modest hardening. Deliberately not stricter than this: ffmpeg spawns
# subprocesses and writes video into the home directory, and a lockdown that
# breaks recording is worse than no lockdown at all.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
